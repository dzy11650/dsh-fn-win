#!/bin/bash
# ==============================================================================
# install_callback — runs after the wizard finishes collecting values.
#
# fnOS passes wizard answers as plain environment variables (NO `TRIM_` prefix),
# e.g. $wizard_api_key, $wizard_service_port, $wizard_mode.
#
# We persist them into ${TRIM_PKGVAR}/.env so the docker-compose stack can
# pick them up via `env_file`. Never hard-code data paths — use the TRIM_*
# variables so upgrades and uninstalls behave correctly.
# ==============================================================================

set -u

ENV_FILE="${TRIM_PKGVAR:-/var/trim/etc}/.env"

# Fail loudly per fnOS rules: write to logfile, then exit 1. Never bare-echo.
fail() {
  echo "$1" >> "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
}

[ -n "${TRIM_PKGVAR:-}" ] || fail "TRIM_PKGVAR not set"

mkdir -p "$(dirname "$ENV_FILE")" || fail "cannot create $(dirname "$ENV_FILE")"

# API Key is required (DSH has no free token).
if [ -z "${wizard_api_key:-}" ]; then
  fail "API Key 未填写，DeepSeek Harness 无法启动"
fi

cat > "$ENV_FILE" <<EOF
# Generated by install_callback — do not edit by hand.
DSH_API_KEY=${wizard_api_key}
DSH_WEB_HOST=0.0.0.0
DSH_WEB_PORT=${wizard_service_port:-3080}
DSH_MODE=${wizard_mode:-standard}
EOF

# Offline self-contained delivery: load the bundled image tar into fnOS Docker.
# The tar ships inside the fpk at app/docker/dsh-harness.tar.
IMAGE_TAR="${TRIM_PKGHOME:-}/app/docker/dsh-harness.tar"
if [ -f "$IMAGE_TAR" ]; then
  docker load -i "$IMAGE_TAR" >> "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 \
    || fail "docker load 失败：$IMAGE_TAR"
else
  fail "未找到镜像包 $IMAGE_TAR，fpk 打包不完整"
fi

exit 0
